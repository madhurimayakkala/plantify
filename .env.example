# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Note: the service role key is no longer used. The API talks to Supabase with
# the anon key plus the signed-in user's Clerk token, so Row Level Security
# applies. You can delete SUPABASE_SERVICE_ROLE_KEY from .env.local and from
# your hosting provider's environment variables.
